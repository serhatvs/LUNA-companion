{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Companion-luna",
  "version": "0.1.0",
  "identifier": "com.companion.luna",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Companion-luna",
        "width": 460,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
