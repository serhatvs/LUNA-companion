{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "mainBinaryName": "LunaApp",
  "version": "0.2.0",
  "identifier": "com.luna.companion",
  "build": {
    "beforeDevCommand": "npm run cli:pack && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run cli:pack && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "externalBin": ["binaries/luna"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A featherweight desktop cat for your builds",
    "longDescription": "Luna is a tiny pixel cat who lives on your desktop, wanders your screens, naps when ignored and cheers when your build goes green.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
