{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Companion-luna",
  "version": "0.1.0",
  "identifier": "com.team.luna",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Code Companion · Luna",
        "width": 420,
        "height": 660,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
